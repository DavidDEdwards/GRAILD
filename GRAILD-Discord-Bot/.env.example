# Create a NEW Discord bot application; never reuse the OAuth broker secret.
DISCORD_BOT_TOKEN=replace_with_your_bot_token
# General Information > Application ID (optional; checked by Discord during sync).
DISCORD_APPLICATION_ID=
# Test server ID. Required while scope=guild (the default).
DISCORD_GUILD_ID=
DISCORD_COMMAND_SCOPE=guild
# Existing public leaderboard origin; no administrator or Redis credentials needed.
GRAILD_BACKEND_URL=https://graild-discord-broker.onrender.com
